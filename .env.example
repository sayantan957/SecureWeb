# Application Secret Key for signing session cookies
# Generate a secure key in Python using: secrets.token_hex(32)
SECRET_KEY=college_secure_file_upload_dev_secret_key_change_in_production_987654321

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1

# Maximum Upload Size in Megabytes (default 10 MB)
MAX_CONTENT_LENGTH_MB=10

# ClamAV Configuration (clamscan path or clamd TCP port)
CLAMSCAN_PATH=C:\Program Files\ClamAV\clamscan.exe
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
